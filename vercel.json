{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/notify?slot=morning",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/notify?slot=tonight",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron/refresh-prices",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "30 1 * * *"
    }
  ]
}
