# Copy to .env.local. Keep in sync with lib/env.ts.
APP_URL=http://localhost:3000

# Database. Local dev: run `pnpm db:local` (PGlite + PostGIS behind a Neon-compatible HTTP endpoint).
DATABASE_URL=postgres://local:local@localhost:4444/mealstretch
DATABASE_HTTP_ENDPOINT=http://localhost:4444/sql
# Production: a Neon connection string, and leave DATABASE_HTTP_ENDPOINT empty.

# Optional: Google Places fallback for location search (LOC-2). App works without it.
GOOGLE_PLACES_API_KEY=

# Claude (receipts, leaflets, tweaks). Without a key the wrapper uses recorded fixtures.
ANTHROPIC_API_KEY=
CLAUDE_MODEL_VISION=claude-sonnet-5-5
CLAUDE_MODEL_FAST=claude-haiku-5-5
# Recorded Claude responses used when ANTHROPIC_API_KEY is empty
CLAUDE_FIXTURE_DIR=fixtures/claude

# Legal gate: must stay false (PRD §18 #1).
ENABLE_WEB_IMPORTERS=false

# Auth.js
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
RESEND_API_KEY=
EMAIL_FROM=MealStretch <hello@example.com>
# Comma-separated admin allow-list (ADM-1)
ADMIN_EMAILS=

# Receipts: private Vercel Blob store
BLOB_READ_WRITE_TOKEN=

# Web push (generate with `pnpm dlx web-push generate-vapid-keys`)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.com

# Vercel Cron shared secret
CRON_SECRET=

# Test-only flag used by Playwright (enables the dev magic-link mailbox). Never set in production.
E2E=

# Error monitoring (optional)
SENTRY_DSN=
