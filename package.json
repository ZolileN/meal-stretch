{
  "name": "mealstretch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:next": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit && pnpm -r --filter ./packages/* typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --project engine",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:local": "tsx scripts/local-db.ts",
    "import:prices": "tsx scripts/import-prices-csv.ts",
    "import:osm": "tsx scripts/import-osm.ts",
    "import:leaflet": "tsx scripts/import-leaflet.ts",
    "bench:engine": "pnpm --filter @mealstretch/engine bench",
    "harness:receipts": "tsx scripts/receipt-harness.ts",
    "prebuild": "tsx scripts/sync-messages.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@mealstretch/engine": "workspace:*",
    "@neondatabase/serverless": "^1.2.1",
    "@vercel/blob": "^2.9.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "1.77.0",
    "next": "^16.4.6",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.15.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@electric-sql/pglite-postgis": "0.2.17",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "fast-check": "^4.10.3",
    "pdf-lib": "1.17.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1"
  }
}
