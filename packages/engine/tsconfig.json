{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["es2023"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "fixtures/**/*.ts", "bench/**/*.ts", "vitest.config.ts"]
}
